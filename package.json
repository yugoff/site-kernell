{
  "name": "kernell-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "dev:cloud": "cd cloud && next dev --port 3001",
    "build:cloud": "node scripts/cloud-workers.mjs build",
    "start:cloud": "npm run preview:cloud",
    "preview:cloud": "cd cloud && wrangler dev --local --port 3001",
    "db:cloud:local": "cd cloud && wrangler d1 migrations apply DB --local",
    "deploy:cloud": "node scripts/cloud-workers.mjs deploy",
    "db:cloud:remote": "node scripts/cloud-workers.mjs migrate",
    "check:cloud": "tsc --noEmit -p cloud/tsconfig.json",
    "test:cloud": "node --test cloud/tests/integration.mjs",
    "start": "npx serve out",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@opennextjs/cloudflare": "1.20.19",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "4.168.0"
  }
}
