# Absolute path on a persistent disk, outside the application release directory.
# CLOUD_DATABASE_PATH=/var/lib/kernell-cloud/cloud.sqlite
# Exact public origin, including when running dev:cloud through a tunnel.
# CLOUD_ORIGIN=https://cloud.kernell.ru
# Disable the disposable demo entry point when opening real sales.
CLOUD_DEMO_ENABLED=true
# Optional process binding for npm run start:cloud (default: 127.0.0.1:3001).
# PORT=3001
# CLOUD_HOSTNAME=127.0.0.1
# Server-side Bearer JWT token for Timeweb Cloud API.
TIMEWEB_TOKEN=
# Optional webhook shared secret protecting POST /api/webhooks/timeweb.
# TIMEWEB_WEBHOOK_SECRET=
# 32-byte hex or base64 key for AES-256-GCM encryption of PII/credentials (required when CLOUD_DEMO_ENABLED=false in prod).
# CLOUD_DATA_ENCRYPTION_KEY=
# Default retail markup percentage applied over Timeweb catalog prices (seeded into pricing_rules).
# CLOUD_DEFAULT_MARKUP_PERCENT=20
# Optional webhook URL and Bearer token for transactional emails (verification, password reset).
# MAILER_WEBHOOK_URL=
# MAILER_WEBHOOK_TOKEN=
# YooKassa API v3 credentials & 54-FZ fiscal receipt configuration.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM_CODE=
# YOOKASSA_TOPUP_PAYMENT_MODE=advance
# YOOKASSA_TOPUP_PAYMENT_SUBJECT=payment
# YOOKASSA_VERIFY_WEBHOOK_IP=true
# Secret Bearer token protecting /api/internal/billing cron & health endpoints.
# CLOUD_INTERNAL_SECRET=
