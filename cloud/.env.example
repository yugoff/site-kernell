# Absolute path on a persistent disk, outside the application release directory.
# CLOUD_DATABASE_PATH=/var/lib/kernell-cloud/cloud.sqlite
# Must match the public HTTPS origin behind a reverse proxy.
# CLOUD_ORIGIN=https://cloud.kernell.ru
# Disable the disposable demo entry point when opening real sales.
CLOUD_DEMO_ENABLED=true
# Optional process binding for npm run start:cloud (default: 127.0.0.1:3001).
# PORT=3001
# CLOUD_HOSTNAME=127.0.0.1
